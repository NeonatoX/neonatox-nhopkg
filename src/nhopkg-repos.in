#!/bin/bash
###############################################################################
#	nhopkg-repos (tool) v. @PACKAGE_VERSION@ @RELEASEDATE@
#	<https://github.com/NeonatoX/neonatox-nhopkg/>
#
#	Copyright (C) 2009-@RELEASEDATE@  Carlos Sánchez <cargabsj175@gmail.com>
#
#	This program is free software: you can redistribute it and/or modify
#	it under the terms of the GNU General Public License as published by
#	the Free Software Foundation, either version 3 of the License, or
#	(at your option) any later version.
#
#	This program is distributed in the hope that it will be useful,
#	but WITHOUT ANY WARRANTY; without even the implied warranty of
#	MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
#	GNU General Public License for more details.
#
#	You should have received a copy of the GNU General Public License
#	along with this program.  If not, see <http://www.gnu.org/licenses/>.
#
###############################################################################
# Description: Repository management tool for nhopkg package manager.
#  Operations:
#  - add-to-repo:      Add .nho packages to a repository (creates it if needed)
#  - sign, sign-all:   Sign packages with GPG
#  - verify:           Verify package GPG signature
#  - keygen:           Generate new GPG key for packager
#  - import-key:       Import public key to trusted keyring
#  - export-key:       Export public key from trusted keyring
#  - list-keys:        List trusted keys
#  - remove-key:       Remove key from trusted keyring
#  - add-repo:         Add repository to configuration
#  - remove-repo:      Remove repository from configuration
#  - list-repos:       List configured repositories
###############################################################################
#==============================================================================
# Section: Basic configurations.
#==============================================================================
## Nhopkg basic variables and configurations. Please don't edit these.
# Get the config file.
prefix="@prefix@"
NHOPKG_CONF="${NHOPKG_CONF:-@sysconfdir@/nhopkg/nhopkg.conf}"
NHOPKG_CONF_DEFAULT="@pkgdatadir@/nhopkg.conf"
if [[ -e "${NHOPKG_CONF}" ]]; then
	source "${NHOPKG_CONF}" 2> /dev/null
elif [[ -e "${NHOPKG_CONF_DEFAULT}" ]]; then
	echog " * Unable to locate Nhopkg configuration file!"
	echog " - Loading default Nhopkg configuration file..."
	source "${NHOPKG_CONF_DEFAULT}" 2> /dev/null
else
	echog " * Unable to locate Nhopkg configuration file!"
	exit 1
fi

# Get core common functions
if [[ -e "${NHOPKG_LIB}" ]]; then
	source "${NHOPKG_LIB}" 2> /dev/null
else
	echog " * Unable to locate Nhopkg core common functions file!"
fi

# Get crypto library (signing/verification)
NHOPKG_CRYPTO_LIB="${NHOPKG_CRYPTO_LIB:-@prefix@/lib/nhopkg/libnhopkg_crypto}"
if [[ -f "${NHOPKG_CRYPTO_LIB}" ]]; then
	source "${NHOPKG_CRYPTO_LIB}" 2> /dev/null
fi

#==============================================================================
# Section: Argument parsing
#==============================================================================
SHORTOPTIONS="Ao:sk:"
LONGOPTIONS="add-to-repo,repo-dir:,sign:,sign-all,verify:,keygen,import-key:,export-key:,list-keys,remove-key:,add-repo:,remove-repo:,list-repos,key:,batch,passphrase-file:,verify-incoming,help,version"

NHPARAMS=$(getopt -o ${SHORTOPTIONS} -l ${LONGOPTIONS} -n "nhopkg-repos" -- "$@")
[[ "${?}" != "0" ]] && { echo "Use --help for usage."; exit 1; }
eval set -- $NHPARAMS

# Variables for argument parsing
SIGN_KEY="${NHOPKG_SIGN_KEY}"
SIGN_BATCH=""
SIGN_PASSPHRASE_FILE=""
VERIFY_INCOMING=0

while [[ "${1}" != "--" ]]; do
	case "${1}" in
		-A|--add-to-repo)
			shift
			[[ -z "${NHOPKG_OPTION}" ]] || { echog " * You have selected more than one valid option." >&2; exit 1; }
			NHOPKG_OPTION="add-to-repo"
		;;
		-o|--repo-dir)
			shift
			if [[ -d "${1}" ]]; then
				REPO_ROOT="$(echo ${1} | sed -e 's@/$@@')"
			else
				echog " * The selected directory doesn't exist in your system." >&2
				exit 1
			fi
			shift
		;;
		-s|--sign)
			shift
			[[ -z "${NHOPKG_OPTION}" ]] || { echog " * You have selected more than one valid option." >&2; exit 1; }
			NHOPKG_OPTION="sign"
			SIGN_PACKAGE="${1}"
			shift
		;;
		--sign-all)
			shift
			[[ -z "${NHOPKG_OPTION}" ]] || { echog " * You have selected more than one valid option." >&2; exit 1; }
			NHOPKG_OPTION="sign-all"
		;;
		--verify)
			shift
			[[ -z "${NHOPKG_OPTION}" ]] || { echog " * You have selected more than one valid option." >&2; exit 1; }
			NHOPKG_OPTION="verify"
			VERIFY_PACKAGE="${1}"
			shift
		;;
		--keygen)
			shift
			[[ -z "${NHOPKG_OPTION}" ]] || { echog " * You have selected more than one valid option." >&2; exit 1; }
			NHOPKG_OPTION="keygen"
		;;
		--import-key)
			shift
			[[ -z "${NHOPKG_OPTION}" ]] || { echog " * You have selected more than one valid option." >&2; exit 1; }
			NHOPKG_OPTION="import-key"
			IMPORT_KEY_SOURCE="${1}"
			shift
		;;
		--export-key)
			shift
			[[ -z "${NHOPKG_OPTION}" ]] || { echog " * You have selected more than one valid option." >&2; exit 1; }
			NHOPKG_OPTION="export-key"
			EXPORT_KEY_ID="${1}"
			shift
		;;
		--list-keys)
			shift
			[[ -z "${NHOPKG_OPTION}" ]] || { echog " * You have selected more than one valid option." >&2; exit 1; }
			NHOPKG_OPTION="list-keys"
		;;
		--remove-key)
			shift
			[[ -z "${NHOPKG_OPTION}" ]] || { echog " * You have selected more than one valid option." >&2; exit 1; }
			NHOPKG_OPTION="remove-key"
			REMOVE_KEY_ID="${1}"
			shift
		;;
		--add-repo)
			shift
			[[ -z "${NHOPKG_OPTION}" ]] || { echog " * You have selected more than one valid option." >&2; exit 1; }
			NHOPKG_OPTION="add-repo"
			ADD_REPO_NAME="${1}"
			shift
			ADD_REPO_URL="${1}"
			shift
		;;
		--remove-repo)
			shift
			[[ -z "${NHOPKG_OPTION}" ]] || { echog " * You have selected more than one valid option." >&2; exit 1; }
			NHOPKG_OPTION="remove-repo"
			REMOVE_REPO_NAME="${1}"
			shift
		;;
		--list-repos)
			shift
			[[ -z "${NHOPKG_OPTION}" ]] || { echog " * You have selected more than one valid option." >&2; exit 1; }
			NHOPKG_OPTION="list-repos"
		;;
		-k|--key)
			shift
			SIGN_KEY="${1}"
			shift
		;;
		--batch)
			shift
			SIGN_BATCH="--batch"
		;;
		--passphrase-file)
			shift
			SIGN_PASSPHRASE_FILE="--passphrase-file ${1}"
			shift
		;;
		--verify-incoming)
			shift
			VERIFY_INCOMING=1
		;;
		-h|--help)
			echog "Usage: nhopkg-repos <command> [options]"
			echo
			echog "Repository management:"
			echog "  -A, --add-to-repo             Add packages to a repository"
			echog "  -o, --repo-dir <dir>          Repository root directory"
			echog "      --add-repo <name> <url>   Add repository to configuration"
			echog "      --remove-repo <name>      Remove repository from configuration"
			echog "      --list-repos              List configured repositories"
			echo
			echog "Signing & verification:"
			echog "  -s, --sign <pkg.nho>          Sign a package"
			echog "      --sign-all                Sign unsigned packages in repo"
			echog "      --verify <pkg.nho>        Verify package signature"
			echog "      --keygen                  Generate new GPG key"
			echog "      --import-key <file|url>   Import public key"
			echog "      --export-key [<id>]       Export public key"
			echog "      --list-keys               List trusted keys"
			echog "      --remove-key <id>         Remove key from trust ring"
			echo
			echog "Options:"
			echog "  -k, --key <id>                Key to use for signing"
			echog "      --batch                   Non-interactive mode (CI/CD)"
			echog "      --passphrase-file <file>  Passphrase file (batch mode)"
			echog "      --verify-incoming         Verify incoming package signatures"
			echo
			echog "  -h, --help                    Show this help"
			echog "      --version                 Show version"
			exit 0
		;;
		--version)
			echo "nhopkg-repos @PACKAGE_VERSION@"
			echo "Copyright (C) 2009-@RELEASEDATE@  Carlos Sánchez <cargabsj175@gmail.com>"
			exit 0
		;;
		--)
			shift
			break
		;;
		*)
			shift
		;;
	esac
done

# Packages to operate on, as an array. Iterating a quoted string used to
# word-split it, so "my package.nho" became two bogus entries.
CASEPACKAGES=("$@")

[[ -z "${NHOPKG_OPTION}" ]] && {
	echog " * No operation specified. Use --help." >&2
	exit 1
}

# Root validation for repo operations
if [[ "${NHOPKG_OPTION}" == "add-to-repo" ]]; then
	[[ "${UID}" != "0" ]] && { echo " * Root privileges required." >&2; exit 1; }
fi

#==============================================================================
# Section: Operation dispatch
#==============================================================================
case "${NHOPKG_OPTION}" in
	#----------------------------------------------------------------------
	# sign: sign a single .nho package
	#----------------------------------------------------------------------
	sign)
		[[ -f "${SIGN_PACKAGE}" ]] || { echog " * Package not found: ${SIGN_PACKAGE}" >&2; exit 1; }
		echogn " :: Signing:"
		echo " $(basename "${SIGN_PACKAGE}")"

		# Extract data.tar.zst from the .nho
		pkg_dir=$(mktemp -d) || exit 1
		tar xf "${SIGN_PACKAGE}" -C "${pkg_dir}" data.tar.zst 2>/dev/null || {
			echog " * Invalid package." >&2; rm -rf "${pkg_dir}"; exit 1
		}

		# Check if already signed
		has_sig=0
		for sig in "${pkg_dir}"/signature*.gpg; do
			[[ -f "${sig}" ]] && { has_sig=1; break; }
		done

		if [[ ${has_sig} -eq 1 ]]; then
			echog " - Package already has a signature. Use --force to add another."
			rm -rf "${pkg_dir}"
			exit 0
		fi

		# Sign
		if crypto_sign_package_ext "${pkg_dir}/data.tar.zst" "${pkg_dir}" "${SIGN_KEY}"; then
			echog " --- Signature created: signature.gpg"

			# Repack the .nho with the new signature
			cd "${pkg_dir}" && tar cp * > "${SIGN_PACKAGE}" && cd "${CWD}"
			echog " - Package signed: $(basename "${SIGN_PACKAGE}")"
			rm -rf "${pkg_dir}"
			exit 0
		else
			echog " *** Failed to sign package." >&2
			rm -rf "${pkg_dir}"
			exit 1
		fi
		;;

	#----------------------------------------------------------------------
	# sign-all: sign all unsigned packages in a repo
	#----------------------------------------------------------------------
	sign-all)
		[[ -n "${REPO_ROOT}" ]] || { echog " * Must specify --repo-dir." >&2; exit 1; }
		[[ -d "${REPO_ROOT}" ]] || { echog " * Repository root does not exist." >&2; exit 1; }

		signed=0
		skipped=0
		failed=0

		find "${REPO_ROOT}" -name '*.nho' -print0 2>/dev/null > "${REPO_ROOT}/.nho-list.tmp"
		_nh_sign_total=$(tr -cd '\0' < "${REPO_ROOT}/.nho-list.tmp" | wc -c)
		_nh_sign_done=0
		while IFS= read -r -d '' pkg; do
			echogn " :: $(basename "${pkg}")..."

			pkg_dir=$(mktemp -d) || continue
			tar xf "${pkg}" -C "${pkg_dir}" data.tar.zst 2>/dev/null || {
				rm -rf "${pkg_dir}"; continue
			}

			# Check for existing signature
			has_sig=0
			for sig in "${pkg_dir}"/signature*.gpg; do
				[[ -f "${sig}" ]] && { has_sig=1; break; }
			done

			if [[ ${has_sig} -eq 1 ]]; then
				echo " already signed (skipped)"
				skipped=$((skipped + 1))
				rm -rf "${pkg_dir}"
				_nh_sign_done=$((_nh_sign_done + 1))
				nhopkg_draw_progress_bar count "${_nh_sign_done}" "${_nh_sign_total}" "sign"
				continue
			fi

			if crypto_sign_package_ext "${pkg_dir}/data.tar.zst" "${pkg_dir}" "${SIGN_KEY}"; then
				cd "${pkg_dir}" && tar cp * > "${pkg}" && cd "${CWD}"
				echo " signed"
				signed=$((signed + 1))
			else
				echo " FAILED"
				failed=$((failed + 1))
			fi
			rm -rf "${pkg_dir}"
			_nh_sign_done=$((_nh_sign_done + 1))
			nhopkg_draw_progress_bar count "${_nh_sign_done}" "${_nh_sign_total}" "sign"
		done < "${REPO_ROOT}/.nho-list.tmp"
		rm -f "${REPO_ROOT}/.nho-list.tmp"
		echo >&2

		echog " --- Sign-all complete: ${signed} signed, ${skipped} skipped, ${failed} failed."
		[[ ${failed} -eq 0 ]] || exit 1
		exit 0
		;;

	#----------------------------------------------------------------------
	# verify: verify a package signature
	#----------------------------------------------------------------------
	verify)
		[[ -f "${VERIFY_PACKAGE}" ]] || { echog " * Package not found: ${VERIFY_PACKAGE}" >&2; exit 1; }

		tmpdir=$(mktemp -d) || exit 1
		tar xf "${VERIFY_PACKAGE}" -C "${tmpdir}" data.tar.zst 2>/dev/null || {
			echog " * Invalid package." >&2; rm -rf "${tmpdir}"; exit 1
		}

		NHOPKG_TMPDIR="${tmpdir}"
		if crypto_verify_signature; then
			echog " --- Package signature is valid."
			rm -rf "${tmpdir}"
			exit 0
		else
			echog " *** Package signature verification FAILED." >&2
			rm -rf "${tmpdir}"
			exit 1
		fi
		;;

	#----------------------------------------------------------------------
	# keygen: generate new GPG key
	#----------------------------------------------------------------------
	keygen)
		crypto_generate_key --key-id "${ADD_REPO_NAME}" --name "${ADD_REPO_URL}" \
			${SIGN_BATCH} ${SIGN_PASSPHRASE_FILE}
		exit $?
		;;

	#----------------------------------------------------------------------
	# import-key: import public key to trusted keyring
	#----------------------------------------------------------------------
	import-key)
		crypto_import_key "${IMPORT_KEY_SOURCE}"
		exit $?
		;;

	#----------------------------------------------------------------------
	# export-key: export public key from trusted keyring
	#----------------------------------------------------------------------
	export-key)
		crypto_export_key "${EXPORT_KEY_ID}"
		exit $?
		;;

	#----------------------------------------------------------------------
	# list-keys: list trusted keys
	#----------------------------------------------------------------------
	list-keys)
		crypto_list_keys
		exit 0
		;;

	#----------------------------------------------------------------------
	# remove-key: remove key from trusted keyring
	#----------------------------------------------------------------------
	remove-key)
		crypto_remove_key "${REMOVE_KEY_ID}"
		exit $?
		;;

	#----------------------------------------------------------------------
	# add-repo: add repository to configuration
	#----------------------------------------------------------------------
	add-repo)
		[[ -n "${ADD_REPO_NAME}" && -n "${ADD_REPO_URL}" ]] || {
			echog " * Usage: nhopkg-repos --add-repo <name> <url>" >&2; exit 1
		}

		upper_name="${ADD_REPO_NAME^^}"
		conf="${NHOPKG_CONF}"

		# Add to NHOPKG_ACTIVE_REPOS if not already present
		if ! grep -q "NHOPKG_ACTIVE_REPOS.*${ADD_REPO_NAME}" "${conf}" 2>/dev/null; then
			sed -i "/^NHOPKG_ACTIVE_REPOS=/ s/\"$/ ${ADD_REPO_NAME}\"/" "${conf}"
			echog " --- Added ${ADD_REPO_NAME} to NHOPKG_ACTIVE_REPOS"
		else
			echog " - ${ADD_REPO_NAME} already in NHOPKG_ACTIVE_REPOS"
		fi

		# Add repo URL variable at the end of the repo section
		if ! grep -q "^NHOPKG_REPO_${upper_name}=" "${conf}" 2>/dev/null; then
			# Find the last NHOPKG_REPO_ line and insert after it
			last_line=$(grep -n "^NHOPKG_REPO_" "${conf}" 2>/dev/null | tail -1 | cut -d: -f1)
			if [[ -n "${last_line}" ]]; then
				sed -i "${last_line}a NHOPKG_REPO_${upper_name}=\"${ADD_REPO_URL}\"" "${conf}"
			else
				echo "NHOPKG_REPO_${upper_name}=\"${ADD_REPO_URL}\"" >> "${conf}"
			fi
			echog " --- Repository added: ${ADD_REPO_NAME} -> ${ADD_REPO_URL}"
		else
			echog " - NHOPKG_REPO_${upper_name} already exists in config."
		fi
		exit 0
		;;

	#----------------------------------------------------------------------
	# remove-repo: remove repository from configuration
	#----------------------------------------------------------------------
	remove-repo)
		[[ -n "${REMOVE_REPO_NAME}" ]] || {
			echog " * Usage: nhopkg-repos --remove-repo <name>" >&2; exit 1
		}

		upper_name="${REMOVE_REPO_NAME^^}"
		conf="${NHOPKG_CONF}"

		# Remove from NHOPKG_ACTIVE_REPOS
		sed -i "/^NHOPKG_ACTIVE_REPOS=/ s/ ${REMOVE_REPO_NAME}//; s/${REMOVE_REPO_NAME} //" "${conf}"

		# Comment out (don't delete) the NHOPKG_REPO_ line
		sed -i "/^NHOPKG_REPO_${upper_name}=/ s/^/# /" "${conf}"

		echog " --- Repository removed: ${REMOVE_REPO_NAME}"
		exit 0
		;;

	#----------------------------------------------------------------------
	# list-repos: list configured repositories
	#----------------------------------------------------------------------
	list-repos)
		conf="${NHOPKG_CONF}"
		echog "Active repositories:"
		for repo in ${NHOPKG_ACTIVE_REPOS}; do
			var="NHOPKG_REPO_${repo^^}"
			url="${!var}"
			echo "  ${repo} -> ${url:-<no URL>}"
		done
		exit 0
		;;

	#----------------------------------------------------------------------
	# add-to-repo: Add packages to a repository (creates it if needed)
	#----------------------------------------------------------------------
	add-to-repo)
	get_pwd_dir
	check_if_root_uid

	[ -z "$REPO_ROOT" ] && { echog " * Must specify --repo-dir." >&2; exit 1; }
	[ ! -d "$REPO_ROOT" ] && { echog " * Repository root does not exist." >&2; exit 1; }

	# The getopt sentinel is still in "$@" (the parse loop stops on it without
	# consuming it), so count the real package arguments instead of using the
	# array length.
	_nh_in_total=0
	for _nh_in_p in "${CASEPACKAGES[@]}"; do
		case "$_nh_in_p" in
			--*) continue ;;
		esac
		_nh_in_total=$((_nh_in_total + 1))
	done
	[ ${_nh_in_total} -eq 0 ] && { echog " * Must specify .nho packages." >&2; exit 1; }

	# --verify-incoming: check NHOPKG_VERIFY_INCOMING from config too
	[[ "${NHOPKG_VERIFY_INCOMING}" == "yes" ]] && VERIFY_INCOMING=1

	if [[ ${VERIFY_INCOMING} -eq 1 ]]; then
		[[ -f "${NHOPKG_TRUSTED_KEYS_DIR}/pubring.kbx" ]] || \
			crypto_init_keyring
	fi

	cleanup_tmp_dir
	make_tmp_dir

	#-----------------------------------------------------------
	# 0. Counters and skip reporting
	#-----------------------------------------------------------
	# Every rejection goes through _nh_repo_skip() so that no package can be
	# dropped without a reason, the progress bar always reaches 100%, and the
	# run can finish with a status that reflects what really happened.
	_nh_added=0
	_nh_skipped=0
	_nh_failed=0
	_nh_integrity_errors=0
	_nh_stale=0
	declare -a _NH_SKIPPED=()
	_nh_repo_skip()
	{
		# $1: package path, $2: reason. $3: "skip" (default) or "fail".
		_NH_SKIPPED+=("${1}"$'\t'"${2}")
		if [[ "${3:-skip}" == "fail" ]]; then
			_nh_failed=$((_nh_failed + 1))
		else
			_nh_skipped=$((_nh_skipped + 1))
		fi
		_nh_in_done=$((_nh_in_done + 1))
		nhopkg_draw_progress_bar count "${_nh_in_done}" "${_nh_in_total}" "pkg"
	}

	#-----------------------------------------------------------
	# 1. Process incoming packages
	#-----------------------------------------------------------
	# _nh_in_total was already computed above, next to the "no packages"
	# guard, so the progress bar below has a denominator to divide by.
	_nh_in_done=0
	for pkgpath in "${CASEPACKAGES[@]}"; do
		case "$pkgpath" in
			--*) continue ;;
		esac

		[ ! -f "$pkgpath" ] && {
			echog " * Package not found: $pkgpath"
			_nh_repo_skip "$pkgpath" "file not found"
			continue
		}

		echogn " :: Adding package: $(basename "$pkgpath")"

		# --verify-incoming: check signature before processing
		if [[ ${VERIFY_INCOMING} -eq 1 ]]; then
			if ! crypto_verify_incoming "$pkgpath"; then
				echog " *** REJECTED: package signature not trusted." >&2
				_nh_repo_skip "$pkgpath" "signature not trusted"
				continue
			fi
		fi

		# Extract nhoid
		tar xfO "$pkgpath" nhoid > "$NHOPKG_TMPDIR/nhoid" 2>/dev/null || {
			echog " * Invalid package." >&2
			_nh_repo_skip "$pkgpath" "unreadable or invalid tar archive"
			continue
		}

		# nhoid compatibility gate. get_nhoid_data() reacts to a missing or
		# foreign nhoid by calling exit 1, which kills the whole run: one
		# stale package silently dropped every package queued after it.
		# Checking the marker first keeps the failure local to this package.
		_nh_pkg_nhoid=$(grep "^#%NHO-" "$NHOPKG_TMPDIR/nhoid" 2> /dev/null | sed -e 's@^#%NHO-@@')
		if [[ -z "${_nh_pkg_nhoid}" ]]; then
			echog " * Not a nhopkg package: no nhoid marker." >&2
			_nh_repo_skip "$pkgpath" "no nhoid marker"
			continue
		elif [[ "${_nh_pkg_nhoid}" != "${NHOID_VERSION}" ]]; then
			echog " * Package uses nhoid ${_nh_pkg_nhoid}, this nhopkg uses ${NHOID_VERSION}." >&2
			_nh_repo_skip "$pkgpath" "nhoid ${_nh_pkg_nhoid} != ${NHOID_VERSION}"
			continue
		fi

		get_nhoid_data "$NHOPKG_TMPDIR/nhoid"

		# Sanitize package identity. meta_name becomes a file name in the
		# staging dir and in core.packages/core.files, and pkgname is also
		# used as a glob, so a hostile nhoid could otherwise walk out of the
		# staging dir or delete unrelated entries. Repository names are
		# already checked right below for the very same reason.
		if [[ -z "${pkgname}" || -z "${pkgversion}" || -z "${pkgrevision}" ]]; then
			echog " * Incomplete package metadata (name, version or release missing)." >&2
			_nh_repo_skip "$pkgpath" "incomplete nhoid metadata"
			continue
		fi
		meta_name="$pkgname-$pkgversion-$pkgrevision"
		case "${pkgname}" in
			[A-Za-z0-9]|[A-Za-z0-9][A-Za-z0-9._+-]*) : ;;
			*) echog " >>> Invalid package name in nhoid: '${pkgname}'. Package rejected." >&2
			   _nh_repo_skip "$pkgpath" "invalid package name"; continue ;;
		esac
		case "${meta_name}" in
			*[!A-Za-z0-9._+~-]*) echog " >>> Invalid version or release in nhoid: '${pkgversion}-${pkgrevision}'. Package rejected." >&2
			   _nh_repo_skip "$pkgpath" "invalid version/release"; continue ;;
		esac

		repo="${pkgrepo:-extra}"
		# Sanitize: lowercase only, no path components and no traversal.
		# Repodir names feed mkdir/cp straight into the filesystem.
		repo="${repo,,}"
		case "${repo}" in
			[a-z0-9]|[a-z0-9][a-z0-9._-]*[a-z0-9]) : ;;
			*) echog " >>> Invalid repository name in nhoid: '${pkgrepo}'. Package rejected." >&2
			   _nh_repo_skip "$pkgpath" "invalid repository name"; continue ;;
		esac
		repodir="$REPO_ROOT/$repo"
		mkdir -p "$repodir"

		# The staging structure is prepared before the retirement pass below,
		# which needs it to drop the metadata of the versions it removes.
		mkdir -p "$NHOPKG_TMPDIR/$repo/packages" "$NHOPKG_TMPDIR/$repo/files"

		# Remove older versions. The name is matched against the nhoid of
		# each candidate, so a package whose name merely starts with this
		# one is never removed.
		#
		# The metadata of a retired version has to go with it. The published
		# index is unpacked into this same staging area further down, so
		# deleting the .nho while leaving its entry behind made the repository
		# advertise a package that could not be downloaded ("lasted version
		# available" pointing at nothing). That metadata lives in two places:
		# the staging area, for a version staged earlier in this very run, and
		# the published index, for one retired by an earlier run. Both are
		# handled here: the first is deleted, the second is recorded in
		# "retired" and purged before the index is rebuilt.
		for old in "$repodir"/"${pkgname}"-*.nho; do
			[ -f "$old" ] || continue
			old_nhoid=$(tar xfO "$old" nhoid 2>/dev/null)
			old_name=$(printf '%s' "$old_nhoid" | grep "^# Name:" | awk -F'\t' '{print $2}')
			[ "$old_name" = "$pkgname" ] || continue
			rm -f "$old"
			old_version=$(printf '%s' "$old_nhoid" | grep "^# Version:" | awk -F'\t' '{print $2}')
			old_release=$(printf '%s' "$old_nhoid" | grep "^# Release:" | awk -F'\t' '{print $2}')
			# Without a full id there is nothing to purge by name. The entry
			# is then reported by the reverse audit instead of silently kept.
			[[ -n "$old_version" && -n "$old_release" ]] || continue
			old_full="${old_name}-${old_version}-${old_release}"
			rm -f "$NHOPKG_TMPDIR/$repo/packages/$old_full" \
				  "$NHOPKG_TMPDIR/$repo/files/$old_full"
			printf '%s\t%s\t%s\n' "$old_name" "$old_version" "$old_release" \
				>> "$NHOPKG_TMPDIR/$repo/retired"
		done

		# A package without data.tar.zst (a metapackage, or a build whose
		# file list came out empty) is valid: it has no files to sign and no
		# file list to publish. Treating it as an error used to drop it from
		# the repository without printing a word.
		pkg_has_data=0
		tar tf "$pkgpath" 2>/dev/null | grep -qx "data.tar.zst" && pkg_has_data=1

		# Sign package if it has no signature and signing is enabled
		if [[ "${NHOPKG_SIGN_PACKAGES}" == "yes" && ${pkg_has_data} -eq 1 ]]; then
			has_sig=0
			if ! pkg_tmp=$(mktemp -d); then
				echog " * Unable to create a temporary directory to sign the package." >&2
				_nh_repo_skip "$pkgpath" "mktemp failed" "fail"
				continue
			fi
			if ! tar xf "$pkgpath" -C "$pkg_tmp" data.tar.zst 2>/dev/null; then
				rm -rf "$pkg_tmp"
				echog " * Unable to read data.tar.zst from the package." >&2
				_nh_repo_skip "$pkgpath" "unreadable data.tar.zst" "fail"
				continue
			fi
			for sig in "$pkg_tmp"/signature*.gpg; do
				[[ -f "${sig}" ]] && { has_sig=1; break; }
			done

			if [[ ${has_sig} -eq 0 ]]; then
				echog "   - Signing package..."
				if crypto_sign_package_ext "$pkg_tmp/data.tar.zst" "$pkg_tmp" "${SIGN_KEY}"; then
					cd "$pkg_tmp" && tar cp * > "$pkgpath" && cd "$CWD"
					echog "   - Signed."
				fi
			fi
			rm -rf "$pkg_tmp"
		elif [[ ${pkg_has_data} -eq 0 ]]; then
			echog "   - No data.tar.zst: adding it with an empty file list."
		fi

		if ! cp "$pkgpath" "$repodir/"; then
			echog " * Unable to copy the package into ${repo}." >&2
			_nh_repo_skip "$pkgpath" "copy to ${repo} failed" "fail"
			continue
		fi

		# The staging structure (packages/, files/) was created before the
		# retirement pass at the top of the loop, which writes into it.
		cp "$NHOPKG_TMPDIR/nhoid" "$NHOPKG_TMPDIR/$repo/packages/$meta_name"

		# Extract file list into a per-package directory: extracting
		# data.tar.zst at the root of the shared temp dir let a leftover file
		# from a previous package leak into this one.
		if [[ ${pkg_has_data} -eq 1 ]]; then
			_nh_datadir="${NHOPKG_TMPDIR}/.data.$$"
			rm -rf "${_nh_datadir}"
			mkdir -p "${_nh_datadir}"
			if tar xf "$pkgpath" -C "$_nh_datadir" data.tar.zst 2>/dev/null && \
				zstd -dc "$_nh_datadir/data.tar.zst" 2>/dev/null | \
				tar -tf - 2>/dev/null > "$NHOPKG_TMPDIR/$repo/files/$meta_name"; then
				_nh_file_ok=1
			else
				_nh_file_ok=0
				rm -f "$NHOPKG_TMPDIR/$repo/files/$meta_name"
			fi
			rm -rf "${_nh_datadir}"
			# An indexed package with no file list is broken for the client:
			# report it instead of publishing a half-updated repository.
			if [[ ${_nh_file_ok} -eq 0 ]]; then
				echog " * Unable to read the file list of ${meta_name}." >&2
				_nh_repo_skip "$pkgpath" "unreadable data.tar.zst payload" "fail"
				continue
			fi
		fi
		_nh_added=$((_nh_added + 1))
		_nh_in_done=$((_nh_in_done + 1))
		nhopkg_draw_progress_bar count "${_nh_in_done}" "${_nh_in_total}" "pkg"
	done
	echo >&2

	#-----------------------------------------------------------
	# 2. Rebuild repository metadata (per affected repo)
	#-----------------------------------------------------------
	for repo in "$NHOPKG_TMPDIR"/*; do
		[ -d "$repo" ] || continue

		reponame=$(basename "$repo")
		repodir="$REPO_ROOT/$reponame"
		echogn " :: Updating repository: $reponame"
		mkdir -p "$repodir"

		# ---------- PACKAGES ----------
		tmpbuild="$NHOPKG_TMPDIR/$reponame/.build.$$"
		mkdir -p "$tmpbuild"

		if [ -f "$repodir/core.packages.tar.zst" ]; then
			zstd -dc "$repodir/core.packages.tar.zst" 2>/dev/null | \
			tar xf - -C "$tmpbuild" 2>/dev/null
		fi

		# Drop the metadata of the versions retired during this run, before
		# the index is rebuilt: the published one was just unpacked above, and
		# the staging area was already cleaned by the retirement pass itself.
		# Purging first and dumping after means that an id retired and
		# re-added in the same call (the same .nho passed twice) ends up
		# published once, which is the intent.
		if [ -f "$repo/retired" ]; then
			while IFS=$'\t' read -r _nh_ret_name _nh_ret_ver _nh_ret_rel; do
				[[ -n "$_nh_ret_name" && -n "$_nh_ret_ver" && -n "$_nh_ret_rel" ]] || continue
				rm -f "$tmpbuild/${_nh_ret_name}-${_nh_ret_ver}-${_nh_ret_rel}" \
					  "$tmpbuild/${_nh_ret_name}-${_nh_ret_ver}" \
					  "$tmpbuild/${_nh_ret_name}"
			done < "$repo/retired"
		fi

		_nh_meta_total=0
		for _nh_meta_c in "$repo/packages/"*; do
			[ -f "$_nh_meta_c" ] || continue
			_nh_meta_total=$((_nh_meta_total + 1))
		done
		_nh_meta_done=0
		for newmeta in "$repo/packages/"*; do
			[ -f "$newmeta" ] || continue
			get_basic_data "$newmeta"
			full="$pkgname-$pkgversion-$pkgrevision"
			# Purge ONLY this package's own entries. A "name-*" glob would
			# also wipe packages whose name merely starts with "name-"
			# (adding "alpha" used to unindex "alpha-devel" for good).
			rm -f "$tmpbuild/$full" "$tmpbuild/$pkgname-$pkgversion" \
				"$tmpbuild/$pkgname"
			cp "$newmeta" "$tmpbuild/$full"
			ln -sf "$full" "$tmpbuild/$pkgname-$pkgversion"
			ln -sf "$full" "$tmpbuild/$pkgname"
			_nh_meta_done=$((_nh_meta_done + 1))
			nhopkg_draw_progress_bar count "${_nh_meta_done}" "${_nh_meta_total}" "${reponame}:pkgs"
		done
		echo >&2

		tar cf "$NHOPKG_TMPDIR/$reponame/.packages.$$" -C "$tmpbuild" . 2>/dev/null
		zstd -q -f "$NHOPKG_TMPDIR/$reponame/.packages.$$"
		cp "$NHOPKG_TMPDIR/$reponame/.packages.$$.zst" "$repodir/core.packages.tar.zst" && rm -f "$NHOPKG_TMPDIR/$reponame/.packages.$$.zst"
		rm -rf "$tmpbuild" "$NHOPKG_TMPDIR/$reponame/.packages.$$"

		# ---------- FILES ----------
		tmpfiles="$NHOPKG_TMPDIR/$reponame/.files.$$"
		mkdir -p "$tmpfiles"

		if [ -f "$repodir/core.files.tar.zst" ]; then
			zstd -dc "$repodir/core.files.tar.zst" 2>/dev/null | \
			tar xf - -C "$tmpfiles" 2>/dev/null
		fi

		# Same purge as in core.packages: a retired version must not leave its
		# file list behind either.
		if [ -f "$repo/retired" ]; then
			while IFS=$'\t' read -r _nh_ret_name _nh_ret_ver _nh_ret_rel; do
				[[ -n "$_nh_ret_name" && -n "$_nh_ret_ver" && -n "$_nh_ret_rel" ]] || continue
				rm -f "$tmpfiles/${_nh_ret_name}-${_nh_ret_ver}-${_nh_ret_rel}"
			done < "$repo/retired"
		fi

		_nh_file_total=0
		for _nh_file_c in "$repo/files/"*; do
			[ -f "$_nh_file_c" ] || continue
			_nh_file_total=$((_nh_file_total + 1))
		done
		_nh_file_done=0
		for newfile in "$repo/files/"*; do
			[ -f "$newfile" ] || continue
			# The staging file name already IS pkgname-pkgversion-pkgrevision
			# (see meta_name in the package loop), so purging it by exact
			# name needs no prefix guess and no version splitting.
			rm -f "$tmpfiles/$(basename "$newfile")"
			cp "$newfile" "$tmpfiles/"
			_nh_file_done=$((_nh_file_done + 1))
			nhopkg_draw_progress_bar count "${_nh_file_done}" "${_nh_file_total}" "${reponame}:files"
		done
		echo >&2

		tar cf "$NHOPKG_TMPDIR/$reponame/.filesbuild.$$" -C "$tmpfiles" . 2>/dev/null
		zstd -q -f "$NHOPKG_TMPDIR/$reponame/.filesbuild.$$"
		cp "$NHOPKG_TMPDIR/$reponame/.filesbuild.$$.zst" "$repodir/core.files.tar.zst" && rm -f "$NHOPKG_TMPDIR/$reponame/.filesbuild.$$.zst"
		rm -rf "$tmpfiles" "$NHOPKG_TMPDIR/$reponame/.filesbuild.$$"

		# ---------- content.db ----------
		(
			cd "$repodir"
			for f in *.nho; do
				[ -f "$f" ] || continue
				size=$(stat -c %s "$f" 2>/dev/null)
				echo "$size $f"
			done > content.db
			zstd --rm -q -f content.db
		)

		date -u +%s > "$repodir/lastsync"

		# Sign repo metadata
		crypto_sign_repo_metadata "${repodir}" "${SIGN_KEY}"

		# ---------- integrity check ----------
		# A repository is only usable if every .nho sitting in it is
		# reachable through the published index. Rebuilding the index used
		# to purge entries with a "name-*" glob, which silently unindexed
		# any package whose name merely started with the one being added:
		# the .nho stayed on disk and nhopkg reported it as missing. Check
		# the metadata that was just written against the packages that are
		# actually there, instead of trusting the variables of this run.
		_nh_chk_dir="${NHOPKG_TMPDIR}/$reponame/.check.$$"
		rm -rf "${_nh_chk_dir}"
		mkdir -p "${_nh_chk_dir}"
		# Only regular entries take part in the reverse audit below: the
		# "<name>" and "<name>-<version>" entries are symlinks and have no
		# .nho of their own by design. Plain "tar tf" does not reveal the
		# link, so the long listing is used and the ones whose mode starts
		# with "l" are dropped. Index ids are validated as [A-Za-z0-9._+~-]
		# on the way in, so the last field of a regular entry is its name.
		zstd -dc "$repodir/core.packages.tar.zst" 2>/dev/null | \
			tar tvf - 2>/dev/null | awk '$1 !~ /^l/ { n=$NF; sub(/^\.\//, "", n); print n }' | \
			grep -v '^$' | sort -u \
			> "${_nh_chk_dir}/packages"
		zstd -dc "$repodir/core.files.tar.zst" 2>/dev/null | \
			tar tvf - 2>/dev/null | awk '$1 !~ /^l/ { n=$NF; sub(/^\.\//, "", n); print n }' | \
			grep -v '^$' | sort -u \
			> "${_nh_chk_dir}/files"
		_nh_chk_total=0
		: > "${_nh_chk_dir}/live"
		for _nh_chk_f in "$repodir"/*.nho; do
			[ -f "${_nh_chk_f}" ] || continue
			_nh_chk_total=$((_nh_chk_total + 1))
			_nh_chk_id=$(tar xfO "${_nh_chk_f}" nhoid 2>/dev/null | \
				awk -F'\t' '/^# Name:/{n=$2} /^# Version:/{v=$2} /^# Release:/{r=$2} END{print n"-"v"-"r}')
			if [[ -z "${_nh_chk_id}" || "${_nh_chk_id}" == "-" ]]; then
				echog " *** $(basename "${_nh_chk_f}"): unreadable nhoid, cannot be indexed." >&2
				_nh_integrity_errors=$((_nh_integrity_errors + 1))
				continue
			fi
			printf '%s\n' "${_nh_chk_id}" >> "${_nh_chk_dir}/live"
			grep -qxF "${_nh_chk_id}" "${_nh_chk_dir}/packages" || {
				echog " *** $(basename "${_nh_chk_f}"): ${_nh_chk_id} is not in core.packages.tar.zst." >&2
				_nh_integrity_errors=$((_nh_integrity_errors + 1))
			}
			# A package with no data.tar.zst (a metapackage) has no file
			# list by design; only packages that ship files need one.
			if tar tf "${_nh_chk_f}" 2>/dev/null | grep -qx "data.tar.zst"; then
				grep -qxF "${_nh_chk_id}" "${_nh_chk_dir}/files" || {
					echog " *** $(basename "${_nh_chk_f}"): ${_nh_chk_id} has no file list in core.files.tar.zst." >&2
					_nh_integrity_errors=$((_nh_integrity_errors + 1))
				}
			fi
		done

		# Reverse audit: entries in the index with no .nho behind them. The
		# direction above (disk -> index) is an error, because the package is
		# there and cannot be reached. This one is only a warning: it is what
		# a repository published by an older nhopkg-repos looks like, and
		# failing on it would break every such repository with no way out,
		# since repairing it is an explicit operation (--prune-orphans, not
		# part of this release). It is also what a run interrupted between
		# removing a .nho and rewriting the index leaves behind.
		sort -u "${_nh_chk_dir}/live" -o "${_nh_chk_dir}/live" 2>/dev/null
		for _nh_chk_idx in packages files; do
			_nh_chk_stale=$(comm -23 "${_nh_chk_dir}/${_nh_chk_idx}" \
				"${_nh_chk_dir}/live" 2>/dev/null)
			[ -n "${_nh_chk_stale}" ] || continue
			while IFS= read -r _nh_chk_sid; do
				[ -n "$_nh_chk_sid" ] || continue
				echog " ! core.${_nh_chk_idx}: '${_nh_chk_sid}' is indexed but no .nho is in the repository (stale entry)." >&2
				_nh_stale=$((_nh_stale + 1))
			done <<< "$_nh_chk_stale"
		done
		rm -rf "${_nh_chk_dir}"
		if [[ ${_nh_integrity_errors} -eq 0 ]]; then
			echog " - Integrity check passed (${_nh_chk_total} package(s) indexed)."
		fi

		echog " - Repository $reponame updated."
	done

	cleanup_tmp_dir

	echog " --- ${_nh_added} added, ${_nh_skipped} skipped, ${_nh_failed} failed."
	if [[ ${_nh_stale} -gt 0 ]]; then
		echog " ! ${_nh_stale} stale index entr(y/ies) with no .nho behind them." >&2
		echog "   They advertise packages that cannot be downloaded. Re-adding the" >&2
		echog "   matching .nho, or removing the entries by hand, fixes it." >&2
	fi
	if [[ ${#_NH_SKIPPED[@]} -gt 0 ]]; then
		echog " --- Packages not added to the repository:"
		for _nh_entry in "${_NH_SKIPPED[@]}"; do
			_nh_p=${_nh_entry%%$'\t'*}
			_nh_r=${_nh_entry#*$'\t'}
			echog "   - $(basename "${_nh_p}"): ${_nh_r}"
		done
	fi
	if [[ ${_nh_integrity_errors} -gt 0 ]]; then
		echog " *** Repository integrity check FAILED: ${_nh_integrity_errors} problem(s)." >&2
		exit 1
	fi
	if [[ ${_nh_skipped} -gt 0 || ${_nh_failed} -gt 0 ]]; then
		echog " *** Not every requested package made it into the repository." >&2
		exit 1
	fi
	echog " - Incremental repository update completed."
	exit 0
	;;

esac
