#!/bin/bash
# /usr/lib/nhopkg/libnhopkg_nhouser
# Idempotent user/group creation for nhopkg package scripts
#
# Supports two backends:
#   - GNU shadow-utils (useradd/groupadd) — preferred
#   - BusyBox (adduser/addgroup) — fallback for static/embedded environments
#
# Depends on: libnhopkg (for echog)

# ---------------------------------------------------------
# Backend detection
# ---------------------------------------------------------
_nhouser_backend=""

# Verify tools actually execute, not just exist.
# Broken dynamic binaries (e.g. after musl/glibc update) still
# exist on disk but fail with "libc.so.X not found".
_nhouser_shadow_ok() {
	local cmd
	for cmd in useradd groupadd; do
		command -v "$cmd" >/dev/null 2>&1 || return 1
		"$cmd" --help >/dev/null 2>&1 || return 1
	done
	return 0
}

if _nhouser_shadow_ok; then
	_nhouser_backend="shadow"
elif command -v adduser >/dev/null 2>&1 && command -v addgroup >/dev/null 2>&1; then
	_nhouser_backend="busybox"
else
	echog " * ERROR: no user/group creation backend available"
	echog "   Need shadow-utils (useradd/groupadd) or BusyBox (adduser/addgroup)"
	return 1
fi

_nhouser_create_group() {
	local gname="$1" gid="$2"
	if [ "$_nhouser_backend" = "shadow" ]; then
		groupadd -g "$gid" "$gname"
	else
		addgroup -g "$gid" "$gname"
	fi
}

_nhouser_create_user() {
	local user="$1" uid="$2" comment="$3" home="$4" shell="$5" group="$6" groups="$7"
	if [ "$_nhouser_backend" = "shadow" ]; then
		useradd -M \
			-u "$uid" \
			${comment:+-c "$comment"} \
			${home:+-d "$home"} \
			${shell:+-s "$shell"} \
			${group:+-g "$group"} \
			${groups:+-G "$groups"} \
			"$user"
	else
		adduser -D -H \
			-u "$uid" \
			${comment:+-g "$comment"} \
			${home:+-h "$home"} \
			${shell:+-s "$shell"} \
			${groups:+-G "$groups"} \
			"$user" ${group:+ "$group"}
	fi
}

# ---------------------------------------------------------
# nhouser()
# Description: Creates or verifies system users and groups.
#              Supports idempotent operation for package scripts,
#              allowing safe execution during build, install, or
#              post-install phases.
#              User and group creation is performed only when needed,
#              following BLFS/LFS conventions.
# Parameters: Command-line options (--check, --create, --user, --group,
#             --uid, --gid, --shell, --groups, etc.)
# Returns: 0 on success, non-zero on error
# ---------------------------------------------------------
nhouser()
{
	local MODE="${1}"
	shift
	local VERBOSE=0

	local USER="" U_ID="" COMMENT="" HOME="" SHELL=""
	local GNAME="" G_ID="" ADDITIONAL_GROUPS=""
	local GROUP_DONE=0 LOCKED=0

	[ "${1}" = "--verbose" ] && VERBOSE=1

	log() { [ "${VERBOSE}" = 1 ] && echog "$*"; }

	_getent() {
		local db="$1" key="$2"
		if command -v getent >/dev/null 2>&1; then
			getent "$db" "$key"
		else
			case "$db" in
				passwd) awk -F: -v k="$key" '$1==k || $3==k {print; exit}' /etc/passwd ;;
				group)  awk -F: -v k="$key" '$1==k || $3==k {print; exit}' /etc/group ;;
			esac
		fi
	}

	user_exists() { id "$1" >/dev/null 2>&1; }
	group_exists() { _getent group "$1" >/dev/null 2>&1; }

	find_free_id() {
		local type="$1"
		local i="${2:-100}"
		local max="${3:-998}"

		while [ "$i" -le "$max" ]; do
			if [ "$type" = "uid" ]; then
				_getent passwd "$i" >/dev/null 2>&1 || { echo "$i"; return; }
			else
				_getent group "$i" >/dev/null 2>&1 || { echo "$i"; return; }
			fi
			i=$((i+1))
		done
		echo ""
	}

	while [ $# -gt 0 ]; do
		case "$1" in
			--user) USER="$2"; shift ;;
			--uid) U_ID="$2"; shift ;;
			--uname) COMMENT="$2"; shift ;;
			--udir) HOME="$2"; shift ;;
			--shell) SHELL="$2"; shift ;;
			--group) GNAME="$2"; shift ;;
			--gid) G_ID="$2"; shift ;;
			--groups) ADDITIONAL_GROUPS="$2"; shift ;;
			--locked) LOCKED=1 ;;
			--verbose) VERBOSE=1 ;;
			*) echo "Invalid option: $1" >&2; return 1 ;;
		esac
		shift
	done

	[ -z "$MODE" ] && { echo "Missing --check or --create" >&2; return 1; }
	[ -z "$USER$GNAME" ] && { echo "Missing --user or --group" >&2; return 1; }

	[ -n "$U_ID" ] && case $U_ID in *[!0-9]*) echo "Invalid UID: $U_ID" >&2; return 1;; esac
	[ -n "$G_ID" ] && case $G_ID in *[!0-9]*) echo "Invalid GID: $G_ID" >&2; return 1;; esac

	if [ -n "$GNAME" ]; then
		if group_exists "$GNAME"; then
			if [ -n "$G_ID" ]; then
				EXIST_GID=$(_getent group "$GNAME" | cut -d: -f3)
				if [ "$EXIST_GID" != "$G_ID" ]; then
					log "GID mismatch for group $GNAME (have $EXIST_GID, expected $G_ID)"
				fi
			fi
			echog " - Group $GNAME already exists (GID: $EXIST_GID)"
		else
			if [ "$MODE" = "--check" ]; then
				echog " - Group $GNAME does not exist"
				return 1
			fi
			if [ -n "$G_ID" ]; then
				if [ "$G_ID" -ge 999 ] 2>/dev/null; then
					log "GID $G_ID is >= 999, searching lower..."
					G_ID=$(find_free_id gid 100)
					[ -z "$G_ID" ] && { echog " * No free GID available below 999" >&2; return 1; }
				else
					EXIST_NAME=$(_getent group "$G_ID" | cut -d: -f1)
					if [ -n "$EXIST_NAME" ] && [ "$EXIST_NAME" != "$GNAME" ]; then
						log "GID $G_ID in use by $EXIST_NAME, searching free GID..."
						G_ID=$(find_free_id gid)
						[ -z "$G_ID" ] && { echog " * No free GID available below 999" >&2; return 1; }
					fi
				fi
			else
				G_ID=$(find_free_id gid 100)
				[ -z "$G_ID" ] && { echog " * No free GID available below 999" >&2; return 1; }
			fi
			echog " * Creating group $GNAME (backend: $_nhouser_backend)"
			_nhouser_create_group "$GNAME" "$G_ID" || return 1
			GROUP_DONE=1
		fi
	fi

	if [ -n "$USER" ]; then
		if user_exists "$USER"; then
			if [ -n "$U_ID" ]; then
				EXIST_UID=$(_getent passwd "$USER" | cut -d: -f3)
				if [ "$EXIST_UID" != "$U_ID" ]; then
					log "UID mismatch for $USER (have $EXIST_UID, expected $U_ID)"
				fi
			fi
			echog " - User $USER already exists (UID: $EXIST_UID)"
			if [ -n "$LOCKED" ]; then
				passwd -l "$USER" >/dev/null 2>&1 || true
				log " - User $USER locked"
			fi
		else
			if [ "$MODE" = "--check" ]; then
				echog " - User $USER does not exist"
				return 1
			fi
			if [ -n "$U_ID" ]; then
				if [ "$U_ID" -ge 999 ] 2>/dev/null; then
					log "UID $U_ID is >= 999, searching lower..."
					U_ID=$(find_free_id uid 100)
					[ -z "$U_ID" ] && { echog " * No free UID available below 999" >&2; return 1; }
				else
					EXIST_NAME=$(_getent passwd "$U_ID" | cut -d: -f1)
					if [ -n "$EXIST_NAME" ] && [ "$EXIST_NAME" != "$USER" ]; then
						log "UID $U_ID in use by $EXIST_NAME, searching free UID..."
						U_ID=$(find_free_id uid)
						[ -z "$U_ID" ] && { echog " * No free UID available below 999" >&2; return 1; }
					fi
				fi
			else
				U_ID=$(find_free_id uid 100)
				[ -z "$U_ID" ] && { echog " * No free UID available below 999" >&2; return 1; }
			fi
			echog " * Creating user $USER (backend: $_nhouser_backend)"
			_nhouser_create_user "$USER" "$U_ID" "$COMMENT" "$HOME" "$SHELL" "$GNAME" "$ADDITIONAL_GROUPS" || return 1
			if [ -n "$LOCKED" ]; then
				passwd -l "$USER" >/dev/null 2>&1 || true
				log " - User $USER locked"
			fi
		fi
	fi

	return 0
}
